# Kopieer naar .env en pas aan waar nodig.
PORT=4000

# --- Lokaal (docker compose / eigen Postgres) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ecostay
DB_PASSWORD=ecostay
DB_NAME=ecostay
DB_SSL=false

# --- Render (of andere managed Postgres): gebruik één connection string ---
# Zet de Internal Database URL van Render hierin; dan hoef je bovenstaande
# DB_* niet te zetten. Voor de externe URL: DB_SSL=true.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Sta je frontend-URL toe voor CORS (bijv. je Vercel-domein)
CORS_ORIGIN=http://localhost:5173

# --- Mollie ---
# Haal je testsleutel op via dashboard.mollie.com → Developers → API keys
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Maandelijks bedrag in euros (zonder €-teken, punt als decimaalscheider)
MOLLIE_AMOUNT=29.00
# Publieke URL van de API zelf (zodat Mollie de webhook en redirect kan bereiken)
APP_URL=https://ecostay-zqcu.onrender.com
